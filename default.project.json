{
  "name": "crystal-gems",
  "globIgnorePaths": [
    "**/.gitkeep"
  ],
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "$path": "src/shared",
      "$ignoreUnknownInstances": true
    },
    "ServerScriptService": {
      "$path": "src/server",
      "$ignoreUnknownInstances": true
    },
    "ServerStorage": {
      "$path": "src/serverstorage",
      "$ignoreUnknownInstances": true
    },
    "StarterPlayer": {
      "$properties": {
        "EnableMouseLockOption": false
      },
      "StarterPlayerScripts": {
        "$path": "src/client",
        "$ignoreUnknownInstances": true
      }
    }
  }
}
